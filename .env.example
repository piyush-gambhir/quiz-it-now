# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
# Application environment (development, staging, production)
ENVIRONMENT=development

# Public application URL (must be a valid URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================
# AUTHENTICATION
# ==============================================
# Auth secret for NextAuth (generate with: openssl rand -base64 32)
AUTH_SECRET=<your-auth-secret>
# Optional verbose auth logs
# AUTH_DEBUG=false

# ==============================================
# OAUTH PROVIDERS
# ==============================================
# Google OAuth credentials
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# GitHub OAuth credentials
# Get from: https://github.com/settings/developers
GITHUB_CLIENT_ID=<your-github-client-id>
GITHUB_CLIENT_SECRET=<your-github-client-secret>

# ==============================================
# DATABASE
# ==============================================
# MongoDB connection string
MONGODB_URI=<your-mongodb-uri>
MONGODB_DB=<your-mongodb-db>

# ==============================================
# AWS CONFIGURATION
# ==============================================
# AWS credentials for S3 and other services
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
AWS_REGION=us-east-1
S3_BUCKET_NAME=<your-s3-bucket-name>
# Optional public base URL for uploaded files (CDN/custom domain)
# Example: https://files.quizitnow.com
# S3_PUBLIC_BASE_URL=https://files.quizitnow.com

# ==============================================
# AI/ML SERVICES
# ==============================================
# NVIDIA NIM (OpenAI-compatible) credentials
# Get from: https://build.nvidia.com
NVIDIA_API_KEY=<your-nvidia-api-key>
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# Optional comma-separated model list for /api/models
# NVIDIA_MODELS=meta/llama-3.1-70b-instruct,mistralai/mistral-7b-instruct-v0.3,google/gemma-2-9b-it

# OpenAI API key (optional, used for /api/audio/transcribe only)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=<your-openai-api-key>

# ==============================================
# EXTERNAL SERVICES
# ==============================================
# Data scraping backend URL (if applicable)
DATA_SCRAPING_BACKEND_URL=<your-data-scraping-backend-url>

# ==============================================
# DEPRECATED
# ==============================================
# AI Backend URL (DEPRECATED - Now handled directly in Next.js)
# AI_BACKEND_URL=<your-ai-backend-url>
